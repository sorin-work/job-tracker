<section class="mx-auto max-w-3xl py-12 text-center">
  <p class="text-sm font-semibold uppercase tracking-wide text-brand">Job Tracker</p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl">
    Keep your job search on track
  </h1>
  <p class="mt-6 text-lg leading-8 text-zinc-600">
    Every application in one place, from the posting you bookmarked to the offer you signed.
    Move them across a board, keep notes for each interview and never forget to follow up.
  </p>
  <div class="mt-10 flex items-center justify-center gap-4">
    <.link
      navigate={~p"/users/register"}
      class="rounded-lg bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-zinc-700"
    >
      Create an account
    </.link>
    <.link navigate={~p"/users/log_in"} class="text-sm font-semibold text-zinc-900">
      Log in <span aria-hidden="true">→</span>
    </.link>
  </div>
</section>

<section class="mx-auto mt-8 grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
  <div
    :for={
      {icon, title, text} <- [
        {"hero-view-columns", "Pipeline board",
         "Drag applications from wishlist to offer. Every move is kept on a timeline."},
        {"hero-calendar-days", "Interviews",
         "Dates, times, who you're meeting and your prep notes, in your own time zone."},
        {"hero-bell-alert", "Follow-ups",
         "Reminders for what's due today and what slipped, so nothing goes quiet by accident."},
        {"hero-building-office", "Companies and contacts",
         "Recruiters, hiring managers and referrals next to the roles they're tied to."},
        {"hero-banknotes", "Salary and postings",
         "Salary ranges, the posting link and a copy of the description in case it disappears."},
        {"hero-chart-bar", "Stats",
         "Funnel conversion, response rate and how many applications you send each week."}
      ]
    }
    class="rounded-lg border border-zinc-200 bg-white p-5"
  >
    <.icon name={icon} class="h-6 w-6 text-brand" />
    <h2 class="mt-3 font-semibold text-zinc-900">{title}</h2>
    <p class="mt-1 text-sm text-zinc-600">{text}</p>
  </div>
</section>
