<section class="mx-auto max-w-3xl py-12 text-center">
  <p class="text-sm font-semibold uppercase tracking-wide text-brand">Job Tracker</p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl">
    Keep your job search on track
  </h1>
  <p class="mt-6 text-lg leading-8 text-zinc-600">
    Every application in one place, from the posting you bookmarked to the offer you signed.
    Move them across a board, keep notes for each interview and never forget to follow up.
  </p>
  <div class="mt-10 flex items-center justify-center gap-4">
    <.link
      navigate={~p"/users/register"}
      class="rounded-lg bg-zinc-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-zinc-700"
    >
      Create an account
    </.link>
    <.link navigate={~p"/users/log_in"} class="text-sm font-semibold text-zinc-900">
      Log in <span aria-hidden="true">→</span>
    </.link>
  </div>
</section>
