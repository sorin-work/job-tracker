<header class="border-b border-zinc-200 bg-white">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <.link
      navigate={if @current_user, do: ~p"/dashboard", else: ~p"/"}
      class="flex items-center gap-2 font-semibold text-zinc-900"
    >
      <.icon name="hero-briefcase" class="h-6 w-6 text-brand" /> Job Tracker
    </.link>
    <div class="flex items-center gap-4 text-sm">
      <%= if @current_user do %>
        <span class="hidden text-zinc-500 sm:inline">{@current_user.email}</span>
        <.link
          navigate={~p"/users/settings"}
          class="font-medium text-zinc-700 hover:text-zinc-900"
        >
          Settings
        </.link>
        <.link
          href={~p"/users/log_out"}
          method="delete"
          class="font-medium text-zinc-700 hover:text-zinc-900"
        >
          Log out
        </.link>
      <% else %>
        <.link navigate={~p"/users/log_in"} class="font-medium text-zinc-700 hover:text-zinc-900">
          Log in
        </.link>
        <.link
          navigate={~p"/users/register"}
          class="rounded-lg bg-zinc-900 px-3 py-1.5 font-medium text-white hover:bg-zinc-700"
        >
          Sign up
        </.link>
      <% end %>
    </div>
  </div>
  <nav
    :if={@current_user}
    class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
    aria-label="Main"
  >
    <ul class="-mb-px flex gap-1 text-sm">
      <li :for={{label, path, key} <- nav_items()}>
        <.link
          navigate={path}
          class={[
            "flex items-center gap-1.5 border-b-2 px-3 py-2 font-medium",
            if(assigns[:active_nav] == key,
              do: "border-brand text-zinc-900",
              else: "border-transparent text-zinc-500 hover:text-zinc-800"
            )
          ]}
        >
          {label}
          <span
            :if={key == :reminders && (assigns[:due_count] || 0) > 0}
            id="nav-due-count"
            class="rounded-full bg-red-500 px-1.5 text-xs font-semibold text-white"
          >
            {@due_count}
          </span>
        </.link>
      </li>
    </ul>
  </nav>
</header>
<main class="px-4 py-8 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
