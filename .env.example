# Copy to .env and adjust. docker compose reads .env automatically.

# Host ports (container ports stay the same)
DB_PORT=5448
APP_PORT=4408

# Postgres credentials used by the db and app services
POSTGRES_USER=job_tracker
POSTGRES_PASSWORD=job_tracker
POSTGRES_DB=job_tracker

# Signs and encrypts session cookies. Generate one with `mix phx.gen.secret`
# (at least 64 characters) for anything but local use.
SECRET_KEY_BASE=local-development-secret-change-me-local-development-secret-change-me

# Host name and scheme the app is reached at. Used for links in emails and to
# check the origin of LiveView connections.
PHX_HOST=localhost
PHX_SCHEME=http
